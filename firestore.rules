rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Connecté AVEC une adresse e-mail confirmée (31/10/2026). Tout l'accès
    // aux données passe par là : un compte non vérifié ne peut rien lire
    // ni écrire, hormis ce qu'il faut pour s'inscrire (estAuthentifie
    // ci-dessous : sa propre fiche, son pseudo, son entrée d'annuaire).
    function estConnecte() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Connecté, adresse confirmée ou non — uniquement pour l'inscription
    // et la lecture de sa propre fiche (nécessaire à l'écran de
    // vérification et aux contrôles de suspension).
    function estAuthentifie() {
      return request.auth != null;
    }

    function estProprietaire(userId) {
      return estConnecte() && request.auth.uid == userId;
    }

    function estModerateurOuAdmin() {
      return estConnecte()
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderateur'];
    }

    // Masquage (19/10/2026) : hors modérateurs, on peut MASQUER un contenu
    // (masquage automatique des coordonnées personnelles), jamais le
    // DÉMASQUER. Sans cette règle, l'auteur d'un contenu masqué pouvait le
    // rétablir lui-même en écrivant directement dans la base.
    function neDemasquePas() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['masque'])
        || request.resource.data.masque == true;
    }

    function estAdmin() {
      return estConnecte()
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if (estAuthentifie() && request.auth.uid == userId) || estModerateurOuAdmin();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == null);
      allow update: if (estProprietaire(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || estAdmin();
      allow delete: if (estAuthentifie() && request.auth.uid == userId) || estAdmin();
    }

    // Annuaire public minimal (uid + statut banni uniquement).
    // Sert au tirage aléatoire de destinataire pour Écho-Bouteille
    // sans exposer les données privées de la collection users.
    match /annuaire/{userId} {
      allow read: if estConnecte();
      allow create: if (estAuthentifie() && request.auth.uid == userId) || estModerateurOuAdmin();
      allow update: if estProprietaire(userId) || estModerateurOuAdmin();
      allow delete: if false;
    }

    match /echos/{echoId} {
      function seulsChampsReactionOuPlaces() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['jarresBleues', 'coeurs', 'coeursBrises', 'jarresRoses', 'placesOccupees']);
      }
      function modifieLeContenu() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['contenu'])
          && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['supprime'])
               && request.resource.data.supprime == true);
      }
      function dansLaFenetreDeModification() {
        return resource.data.createdAt is timestamp
          && request.time < resource.data.createdAt + duration.value(24, 'h');
      }
      function reouvertureValide() {
        // Si reouverturesRestantes change, ce doit être une vraie réouverture :
        // l'écho passe de fermé (estOuvert=false) à ouvert (estOuvert=true),
        // le compteur décroît d'exactement 1, et reste positif ou nul.
        let changeReouvertures = request.resource.data.diff(resource.data).affectedKeys().hasAny(['reouverturesRestantes']);
        return !changeReouvertures || (
          resource.data.estOuvert == false
          && request.resource.data.estOuvert == true
          && resource.data.reouverturesRestantes > 0
          && request.resource.data.reouverturesRestantes == resource.data.reouverturesRestantes - 1
        );
      }

      // Levier n°1 — Échos partageables (11/08/2026) : n'importe qui avec
      // le lien direct peut lire UN Écho précis par son ID (get) — c'est
      // ce qui permet à un lien partagé sur WhatsApp/Instagram/etc. de
      // fonctionner pour quelqu'un sans compte. Parcourir/lister toute la
      // collection (list) reste réservé aux utilisateurs connectés :
      // impossible de scraper l'ensemble du Fil sans compte.
      allow get: if true;
      allow list: if estConnecte();
      allow create: if estConnecte()
        && request.resource.data.auteurId == request.auth.uid;
      allow update: if estConnecte()
        && (
          (
            resource.data.auteurId == request.auth.uid
            && (!modifieLeContenu() || dansLaFenetreDeModification())
            && reouvertureValide()
            && neDemasquePas()
          )
          || estModerateurOuAdmin()
          || seulsChampsReactionOuPlaces()
        );
      allow delete: if estConnecte()
        && (resource.data.auteurId == request.auth.uid || estModerateurOuAdmin());

      match /echoreps/{repId} {
        // Même principe que ci-dessus : un EchoRep précis reste lisible
        // par lien direct (fait partie de la page publique d'un Écho
        // Ouvert partagé), mais la sous-collection entière ne peut pas
        // être parcourue sans compte.
        allow get: if true;
        allow list: if estConnecte();
        allow create: if estConnecte()
          && (
            request.resource.data.auteurId == request.auth.uid
            || estModerateurOuAdmin()
            || get(/databases/$(database)/documents/echos/$(echoId)).data.auteurId == request.auth.uid
          );
        allow update: if estConnecte()
          && (
            estModerateurOuAdmin()
            || (
              (resource.data.auteurId == request.auth.uid
               || get(/databases/$(database)/documents/echos/$(echoId)).data.auteurId == request.auth.uid)
              && neDemasquePas()
            )
          );
        allow delete: if estConnecte()
          && (
            resource.data.auteurId == request.auth.uid
            || estModerateurOuAdmin()
            || get(/databases/$(database)/documents/echos/$(echoId)).data.auteurId == request.auth.uid
          );
      }
    }

    match /echolegues/{id} {
      // Lecture (24/10/2026) : un Écholègue publié est lisible par tous ;
      // un Écholègue en attente de modération (coordonnées, contenu
      // inapproprié) ou supprimé, seulement par son auteur et les modérateurs.
      allow read: if estConnecte()
        && (resource.data.statut == 'publie'
            || resource.data.auteurId == request.auth.uid
            || estModerateurOuAdmin());
      allow create: if estConnecte()
        && request.resource.data.auteurId == request.auth.uid;
      allow update: if estConnecte()
        && (resource.data.auteurId == request.auth.uid || estModerateurOuAdmin());
      allow delete: if estConnecte()
        && (resource.data.auteurId == request.auth.uid || estModerateurOuAdmin());
    }

    match /echos_bouteille/{id} {
      allow read: if estConnecte()
        && (request.auth.uid == resource.data.expediteurId
            || request.auth.uid == resource.data.destinataireId
            || estModerateurOuAdmin());
      // Création (31/10/2026) : toujours SANS destinataire. Le destinataire
      // est tiré au sort par le serveur (Cloud Function modererEchoBouteille),
      // jamais choisi par l'appli.
      allow create: if estConnecte()
        && request.resource.data.expediteurId == request.auth.uid
        && request.resource.data.destinataireId == null
        && request.resource.data.statut in ['a_distribuer', 'en_attente_moderation']
        && request.resource.data.lu == false;
      // Modification (24/10/2026) : l'expéditeur ne peut plus rien modifier
      // (il pouvait auparavant, en écrivant directement dans la base, changer
      // le texte, le destinataire ou le statut d'une bouteille retenue par la
      // modération). Le destinataire ne peut que la marquer comme lue. La
      // validation et la suppression restent réservées aux modérateurs.
      allow update: if estConnecte()
        && (
          estModerateurOuAdmin()
          || (request.auth.uid == resource.data.destinataireId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']))
        );
      allow delete: if estModerateurOuAdmin();
    }

    // EchoReps de toute l'appli en une seule requête (24/10/2026) : utilisé
    // par l'EchoProfil pour compter MES réponses (section « Participation »).
    // Chacun ne peut lister que ses propres EchoReps par cette voie.
    match /{chemin=**}/echoreps/{repId} {
      allow list: if estConnecte() && resource.data.auteurId == request.auth.uid;
    }

    match /echoreps_attente/{id} {
      function estProprietaireEchoConcerne() {
        return estConnecte()
          && get(/databases/$(database)/documents/echos/$(resource.data.echoId)).data.auteurId == request.auth.uid;
      }
      // Lecture (24/10/2026) : réservée à l'auteur de la proposition, au
      // propriétaire de l'Écho et aux modérateurs. Avant, tout utilisateur
      // connecté pouvait lire toutes les propositions, y compris celles
      // retenues pour coordonnées personnelles, en interrogeant la base
      // directement.
      // Le propriétaire de l'Écho ne lit une proposition qu'une fois validée
      // par l'IA (« en_attente ») — 24/10/2026. Jamais pendant l'analyse, ni
      // si elle est retenue pour coordonnées.
      allow read: if estConnecte()
        && (resource.data.auteurId == request.auth.uid
            || (resource.data.proprietaireId == request.auth.uid
                && resource.data.statut == 'en_attente')
            || estModerateurOuAdmin());
      // Statut à la création (19/10/2026) : une proposition naît toujours
      // « analyse_en_cours » (ou « en_attente_moderation » si le filtre de
      // l'appli y a vu des coordonnées). Impossible de la créer directement
      // « en_attente », c'est-à-dire visible du propriétaire sans analyse.
      allow create: if estConnecte()
        && request.resource.data.auteurId == request.auth.uid
        && request.resource.data.statut in ['analyse_en_cours', 'en_attente_moderation'];
      allow update: if estConnecte()
        && (estProprietaireEchoConcerne() || estModerateurOuAdmin());
      allow delete: if estModerateurOuAdmin();
    }

    match /signalements/{id} {
      allow read: if estModerateurOuAdmin();
      allow create: if estConnecte();
      allow update, delete: if estModerateurOuAdmin();
    }

    match /historique_moderation/{id} {
      allow read: if estModerateurOuAdmin();
      allow create: if estModerateurOuAdmin();
      allow update, delete: if false;
    }

    match /packs/{id} {
      allow read: if estConnecte()
        && (resource.data.userId == request.auth.uid || estAdmin());
      allow create: if estConnecte()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /pseudos/{pseudo} {
      allow read: if true;
      allow create: if estAuthentifie()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /reactions/{id} {
      allow read: if estConnecte() && resource.data.auteurId == request.auth.uid;
      allow create: if estConnecte()
        && request.resource.data.auteurId == request.auth.uid;
      allow update, delete: if false;
    }

    // Compteurs globaux (ex : jarres offertes par la communauté, affiché
    // sur le Fil). Lecture publique — tout le monde doit pouvoir voir le
    // total. Écriture ouverte à tout utilisateur connecté : n'importe qui
    // qui offre une jarre doit pouvoir incrémenter ce compteur, pas
    // seulement les admins (contrairement à la règle précédente qui
    // bloquait cet usage).
    match /stats/{id} {
      allow read: if true;
      allow write: if estConnecte();
    }

    // (Pré-inscriptions supprimées le 31/10/2026 avec la page V0 :
    //  la collection n'est plus accessible du tout.)

    // Notifications (30/09/2026) — un document par événement (réaction,
    // EchoRep, modération) adressé à un destinataire précis.
    match /notifications/{id} {
      // Lecture strictement privée : seul le destinataire (ou un
      // modérateur/admin, pour du support) peut voir ses notifications —
      // jamais l'expéditeur ni un tiers.
      allow read: if estProprietaire(resource.data.destinataireId) || estModerateurOuAdmin();
      // Création ouverte à tout utilisateur connecté : n'importe qui qui
      // réagit à un écho ou répond à un Écho Ouvert doit pouvoir créer la
      // notification adressée à l'auteur — comme pour /reactions. On exige
      // seulement que le champ destinataireId soit bien renseigné ; c'est
      // creerNotification() côté client qui garantit qu'on ne se notifie
      // jamais soi-même.
      allow create: if estConnecte()
        && request.resource.data.destinataireId is string
        && request.resource.data.destinataireId.size() > 0;
      // Mise à jour réservée au destinataire, et seulement pour marquer
      // "lu" — aucun autre champ ne doit pouvoir être modifié après coup.
      allow update: if estProprietaire(resource.data.destinataireId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);
      allow delete: if estProprietaire(resource.data.destinataireId) || estModerateurOuAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
